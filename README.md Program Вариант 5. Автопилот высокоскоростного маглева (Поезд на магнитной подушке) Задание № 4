        public class MaglevControl
        {
            public static double AnalyzeTrackHotspots(double maxAllowedTemp, params double[] trackSensors)
            {
                if (trackSensors == null || trackSensors.Length == 0)
                    return 0.0;

                int exceedingCount = 0;
                foreach (double temp in trackSensors)
                {
                    if (temp > maxAllowedTemp)
                    {
                        exceedingCount++;
                    }
                }

                return (double)exceedingCount / trackSensors.Length * 100.0;
            }
        }
    }
